# Interview API (Django :8000). Token + test/bootstrap. No trailing slash.
VITE_INTERVIEW_TOKEN_URL=http://192.168.1.37:8000/interviews/token

# Optional: Django WebSocket for audio streaming. Default: derived from token URL → ws://host:8000/ws/interview
# VITE_INTERVIEW_WS_URL=ws://192.168.1.37:8000/ws/interview

# Optional: Centrifugo WebSocket URL for receiving messages and TTS audio. Default: ws://192.168.1.37:8001/connection/websocket
# VITE_CENTRIFUGO_WS_URL=ws://192.168.1.37:8001/connection/websocket
